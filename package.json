{
  "name": "paseo-plugin-zcode-provider",
  "version": "0.1.0",
  "description": "Unofficial Paseo provider plugin for ZCode, using the official stdio Services Server of the integrated ZCode CLI.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "zcode",
    "z.ai",
    "glm"
  ],
  "homepage": "https://github.com/supermomonga/paseo-plugin-zcode-provider#readme",
  "bugs": "https://github.com/supermomonga/paseo-plugin-zcode-provider/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermomonga/paseo-plugin-zcode-provider.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "icon.svg",
    "client/",
    "server/",
    "shared/",
    "NOTICE.md",
    "vendor/",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:upstream": "node scripts/check-upstream.mjs",
    "test:runtime": "node scripts/check-runtime.mjs",
    "test:usage-runtime": "node scripts/check-usage-runtime.mjs",
    "test:steering-runtime": "node scripts/check-steering-runtime.mjs",
    "build": "node scripts/build.mjs",
    "format": "prettier --write index.client.tsx index.server.ts client server shared scripts test docs README.md NOTICE.md package.json tsconfig.json tsconfig.client.json vitest.config.ts paseo-plugin.json .github/workflows",
    "format:check": "prettier --check index.client.tsx index.server.ts client server shared scripts test docs README.md NOTICE.md package.json tsconfig.json tsconfig.client.json vitest.config.ts paseo-plugin.json .github/workflows",
    "check:zcode-releases": "node scripts/check-zcode-releases.mjs",
    "check:paseo-releases": "node scripts/check-paseo-releases.mjs",
    "prepare": "node scripts/generate-build-info.mjs",
    "prebuild": "node scripts/generate-build-info.mjs",
    "test:model-plan-runtime": "node scripts/check-model-plan-runtime.mjs",
    "test:e2e": "node scripts/check-e2e.mjs",
    "check:zcode-source": "node scripts/sync-zcode-source.mjs",
    "test:stdio-runtime": "node scripts/check-stdio-runtime.mjs",
    "test:native-restore": "node scripts/check-stdio-runtime.mjs --check-native-restore",
    "setup:managed-runtime": "node scripts/install-managed-runtime.mjs",
    "prepack": "node scripts/pack-manifest.mjs prepack",
    "postpack": "node scripts/pack-manifest.mjs postpack"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.0-beta.5",
    "@getpaseo/plugin": "0.11.0-beta.5",
    "@getpaseo/protocol": "0.11.0-beta.5",
    "@types/node": "22.18.3",
    "@types/react": "~19.2.0",
    "@types/semver": "7.8.0",
    "cheerio": "1.2.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "turndown": "7.2.4",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "which": "5.0.0",
    "zod": "4.4.3"
  }
}
